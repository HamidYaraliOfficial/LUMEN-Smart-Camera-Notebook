<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="lumen_database" />
        <include domain="file" path="lumen_images/" />
        <exclude domain="file" path="lumen_cache/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="lumen_database" />
    </device-transfer>
</data-extraction-rules>
